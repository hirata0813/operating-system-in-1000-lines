ENTRY(boot)

SECTIONS {
    . = 0x80200000;

    /* コード領域 */
    .text :{
        KEEP(*(.text.boot));
        *(.text .text.*);
    }

    /* 定数データ領域．読み取り専用 */
    .rodata : ALIGN(4) {
        *(.rodata .rodata.*);
    }

    /* 読み書き可能データ領域 */
    .data : ALIGN(4) {
        *(.data .data.*);
    }

    /* 読み書き可能データ領域．.data と違い，初期値がゼロの変数を配置 */
    .bss : ALIGN(4) {
        __bss = .; /* 現在のアドレスをシンボル化して，プログラムから参照できるようにする*/
        *(.bss .bss.* .sbss .sbss.*);
        __bss_end = .;
    }

    /* 128KB のスタックを確保．スタック領域の先頭を，4バイト境界のアドレスにする*/
    /* 実際に，各変数が何バイト境界で置かれるかは，コンパイラが決める*/
    . = ALIGN(4);
    . += 128 * 1024;
    __stack_top = .;

    /*動的に割り当てるメモリ領域を確保．領域の先頭を，4KB境界のアドレスにする*/
    . = ALIGN(4096);
    __free_ram = .;
    . += 64 * 1024 * 1024; /* 64MB */
    __free_ram_end = .;
}
